APP_NAME="Vertue CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=vertue_crm
DB_USERNAME=vertue_user
DB_PASSWORD=change_me

JWT_SECRET=change-this-super-secret-key
JWT_TTL_MINUTES=120

DEFAULT_LOCALE=en
FALLBACK_LOCALE=en

FILESYSTEM_DISK=public

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-url-secret
# Optional defense in depth. When set, configure the same value as Telegram's secret_token.
TELEGRAM_WEBHOOK_HEADER_SECRET=

SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.your-domain.com
SESSION_LIFETIME=240

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="Virtue Visa CRM"
